# =============================================================================
# JonisFlow — variáveis de ambiente (NUNCA commitar valores reais)
# Preencha localmente (.env) ou no cofre de secrets do provedor de deploy.
# =============================================================================

# --- Runtime / ambiente ---
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000          # origem da API (CORS do frontend)
WEB_URL=http://localhost:3000                  # domínio do frontend (produção: próprio + HTTPS)

# --- Banco / Redis ---
DATABASE_URL=postgresql://jonis:jonis@localhost:5432/jonisflow?schema=public
REDIS_URL=redis://localhost:6379

# --- Autenticação / JWT ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string        # >= 64 chars em prod
JWT_ACCESS_TTL=15m                                           # access token curto
JWT_REFRESH_TTL=30d                                         # refresh token (stored hashed em sessions)
APP_NAME=JonisFlow

# --- E-mail transacional (Resend / Postmark / SendGrid SMTP) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=api-key-placeholder
SMTP_PASS=resend-api-key-placeholder
MAIL_FROM="JonisFlow <noreply@jonisflow.example.com>"
MAIL_RESET_URL_BASE=http://localhost:3000/reset-password      # base para link de recuperação

# --- Google Maps / Places (API oficial — caminho padrão) ---
GOOGLE_MAPS_API_KEY=                                  # restringir por domain/IP no console
GOOGLE_PLACE_SEARCH_URL=https://maps.googleapis.com/maps/api/place/textsearch/json
# Scraping (Apify) — alternativa com risco jurídico/bloqueio. Apenas se explicitamente aceito:
GOOGLE_SCRAPE_ENABLED=false
APIFY_API_TOKEN=
APIFY_ACTOR_ID=

# --- Cache do Google (ToS): máximo 30 dias; 0 = estrito (sem snapshot de nome/endereço) ---
GOOGLE_SNAPSHOT_TTL_DAYS=30

# --- IA de scoring (heurísticas sempre; LLM opcional via API OpenAI-compatível) ---
AI_LLM_ENABLED=false
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-4o-mini
AI_PROMPT_VERSION=v1

# --- Gateway de pagamento ---
DEFAULT_GATEWAY=stripe                      # stripe | mercadopago (gateway padrão do checkout)
# Stripe (gateway recomendado)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder              # assinatura do webhook
STRIPE_PRICE_ID=price_monthly_placeholder           # produto mensal no Stripe
STRIPE_SUCCESS_URL=http://localhost:3000/billing?status=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?status=canceled
# Mercado Pago (gateway alternativo — assinatura mensal via preapproval)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_API_BASE=https://api.mercadopago.com
MERCADOPAGO_MP_CHECKOUT_BASE=https://www.mercadopago.com.br/subscriptions/checkout
MERCADOPAGO_PRICE=7900                       # centavos (R$ 79,00 mensais)
MERCADOPAGO_CURRENCY=BRL

# --- Backup noturno ---
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *                            # cron: 02:00 diário
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# Storage remoto (S3-compatível: AWS S3, Cloudflare R2, MinIO)
S3_BUCKET=
S3_ENDPOINT=      # ex.: https://<acct>.r2.cloudflarestorage.com (R2)
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Monitoramento ---
MONITOR_HEALTH_PATH=/api/health
TELEGRAM_BOT_TOKEN=                                 # alerta de queda via Telegram
TELEGRAM_CHAT_ID=
# Better Stack / UptimeRobot: criados na plataforma, apontando ao URL de saúde.

# --- Rate limiting ---
RATE_LIMIT_SEARCH_PER_MIN=10                       # por usuário autenticado
RATE_LIMIT_AUTH_PER_15MIN=20                       # por IP
