{
  "name": "jonisflow-api",
  "version": "0.1.0",
  "private": true,
  "description": "JonisFlow API — busca de empresas locais sem site, IA scoring, billing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx scripts/seed.ts",
    "apply-schema": "node scripts/apply-schema.mjs",
    "smoke": "node scripts/smoke-test.cjs",
    "backup": "bash scripts/backup.sh",
    "alert": "bash scripts/alert.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "pino": "^9.6.0",
    "pino-http": "^11.0.0",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@embedded-postgres/linux-x64": "^18.6.0-beta.19",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^6.19.3",
    "@prisma/engines": "^7.10.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
